<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <!-- Logo + nome do app lado a lado -->
        <LinearLayout
            android:layout_width="279dp"
            android:layout_height="116dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="110dp"
                android:layout_height="92dp"
                android:contentDescription="@string/desc_logo"
                android:src="@drawable/logo_grande_clean" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/app_name"
                android:textColor="@color/verde_primario"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Foto de perfil -->
        <ImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="@dimen/tamanho_avatar"
            android:layout_height="@dimen/tamanho_avatar"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_avatar"
            android:clickable="true"
            android:contentDescription="@string/desc_foto_perfil"
            android:focusable="true"
            android:padding="26dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pessoa" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/insira_imagem"
            android:textColor="@color/preto"
            android:textSize="@dimen/texto_pequeno"
            android:textStyle="italic" />

        <!-- Nome -->
        <TextView
            style="@style/Rotulo"
            android:text="@string/nome_label" />

        <EditText
            android:id="@+id/etNome"
            style="@style/Campo"
            android:autofillHints="name"
            android:hint="@string/hint_nome"
            android:inputType="textPersonName|textCapWords" />

        <!-- E-mail -->
        <TextView
            style="@style/Rotulo"
            android:text="@string/email_label" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/Campo"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_email_cadastro"
            android:inputType="textEmailAddress" />

        <!-- Senha -->
        <TextView
            style="@style/Rotulo"
            android:text="@string/senha_label" />

        <EditText
            android:id="@+id/etSenha"
            style="@style/Campo"
            android:autofillHints="newPassword"
            android:hint="@string/hint_senha_cadastro"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp"
            android:text="@string/requisitos_senha"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="12dp"
            android:text="@string/exemplo_senha"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp" />

        <!-- Perfil de acesso -->
        <TextView
            style="@style/Rotulo"
            android:text="@string/perfil_label" />

        <Spinner
            android:id="@+id/spPerfil"
            style="@style/Campo"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="0dp"
            android:popupBackground="@color/branco"
            android:spinnerMode="dropdown" />

        <!-- Botão -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcessar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:text="@string/acessar"
            android:textColor="@color/branco"
            android:textSize="@dimen/texto_rotulo"
            android:textStyle="bold"
            app:backgroundTint="@color/verde_primario"
            app:cornerRadius="@dimen/raio_campo" />
    </LinearLayout>
</ScrollView>