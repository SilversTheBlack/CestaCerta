<?xml version="1.0" encoding="utf-8"?>
<!-- Tela "Sobre Nós" do Cesta Certa -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sobre_nos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".SobreNosActivity">

    <!-- Conteúdo com rolagem (para caber em telas menores) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Logo + nome do app -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Logo do Cesta Certa"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Cesta Certa"
                    android:textColor="@color/verde"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sobre Nós"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Parágrafo 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Somos um time formado por Gabriel Lopes, Gabriel Silva e Larissa Caetano, três pessoas apaixonadas por tecnologia, aprendizado e por transformar ideias em soluções que possam fazer a diferença no dia a dia."
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Parágrafo 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Acreditamos que cada projeto é uma oportunidade de aprender algo novo, enfrentar desafios e evoluir juntos. Por isso, unimos nossos conhecimentos, criatividade e vontade de fazer acontecer para construir experiências cada vez melhores."
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Parágrafo 3 (\n = quebra de linha, igual ao <br/> do HTML) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Este aplicativo nasceu de uma ideia simples, mas com um propósito especial: criar uma solução útil, prática e pensada para facilitar a vida das pessoas.\nEstamos sempre buscando aprender, melhorar e transformar cada desafio em uma nova oportunidade de crescimento.\nSomos três pessoas, uma equipe e muitas ideias para transformar em realidade."
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de navegação de baixo (o ícone laranja é o da tela atual) -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        android:background="@color/verde_claro"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Início"
            android:src="@drawable/nav_inicio" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/verde" />

        <ImageButton
            android:id="@+id/btnNotificacoes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notificações"
            android:src="@drawable/nav_notificacoes" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/verde" />

        <ImageButton
            android:id="@+id/btnSobre"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sobre nós"
            android:src="@drawable/nav_sobre"
            android:tint="#F57C00" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/verde" />

        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            android:src="@drawable/nav_perfil" />
    </LinearLayout>

</LinearLayout>