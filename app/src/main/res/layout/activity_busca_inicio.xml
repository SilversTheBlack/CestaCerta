<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".InicioActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingTop="56dp"
            android:paddingEnd="25dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Logo do Cesta Certa"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Cesta Certa"
                    android:textColor="@color/verde"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/campoBusca"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="80dp"
                android:background="@drawable/bg_caixa_borda"
                android:drawableStart="@drawable/ic_busca"
                android:drawablePadding="8dp"
                android:hint="Pesquise por Produto, categoria ou Mercado"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/black"
                android:textColorHint="#999999"
                android:textSize="12sp"
                android:textStyle="italic" />

            <!-- Painel de CATEGORIAS: os cards são criados pelo InicioActivity
                 (molde: item_categoria_inicio.xml) com os dados da tabela "categorias" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_painel_cinza"
                android:orientation="vertical"
                android:paddingStart="27dp"
                android:paddingTop="30dp"
                android:paddingEnd="27dp"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/tvStatusCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Carregando categorias..."
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/listaCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Mercados"
                android:textColor="@color/verde"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Painel de MERCADOS: os cards são criados pelo InicioActivity
                 (molde: item_mercado_inicio.xml) com os dados da tabela "empresas" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_painel_cinza"
                android:orientation="vertical"
                android:paddingStart="27dp"
                android:paddingTop="30dp"
                android:paddingEnd="27dp"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/tvStatusMercados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Carregando mercados..."
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/listaMercados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        android:background="@color/verde_claro"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Início"
            android:src="@drawable/nav_inicio"
            app:tint="?attr/colorPrimary" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/verde" />

        <ImageButton
            android:id="@+id/btnNotificacoes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notificações"
            android:src="@drawable/nav_notificacoes" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/verde" />

        <ImageButton
            android:id="@+id/btnSobre"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sobre nós"
            android:src="@drawable/nav_sobre" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/verde" />

        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            android:src="@drawable/nav_perfil" />
    </LinearLayout>

</LinearLayout>