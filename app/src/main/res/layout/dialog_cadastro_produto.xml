<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up de cadastro de produto em um mercado -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo + nome do app lado a lado -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/tamanho_logo_cadastro"
                android:layout_height="@dimen/tamanho_logo_cadastro"
                android:contentDescription="@string/desc_logo"
                android:src="@drawable/logo_grande_clean" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/app_name"
                android:textColor="@color/verde_primario"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mercado onde o produto será cadastrado (preenchido pelo código) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLogoMercado"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:contentDescription="@string/desc_logo_mercado"
                android:scaleType="fitCenter"
                tools:src="@drawable/mercado_hipermais" />

            <TextView
                android:id="@+id/tvNomeMercado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/preto"
                android:textSize="@dimen/texto_pequeno"
                android:textStyle="italic"
                tools:text="Hypermais" />
        </LinearLayout>

        <!-- Nome do produto -->
        <TextView
            style="@style/Rotulo"
            android:text="@string/nome_produto_label" />

        <EditText
            android:id="@+id/etNomeProduto"
            style="@style/Campo"
            android:hint="@string/hint_nome_produto"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <!-- Preço -->
        <TextView
            style="@style/Rotulo"
            android:text="@string/preco_label" />

        <EditText
            android:id="@+id/etPreco"
            style="@style/Campo"
            android:digits="0123456789,.R$"
            android:hint="@string/hint_preco"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <!-- Imagem do produto -->
        <TextView
            android:id="@+id/btnInserirImagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="@string/insira_imagem_aqui"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp"
            android:textStyle="italic" />

        <!-- Botão -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/salvar"
            android:textColor="@color/branco"
            android:textSize="@dimen/texto_rotulo"
            android:textStyle="bold"
            app:backgroundTint="@color/verde_primario"
            app:cornerRadius="@dimen/raio_campo" />
    </LinearLayout>
</ScrollView>