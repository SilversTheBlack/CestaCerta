<?xml version="1.0" encoding="utf-8"?>
<!-- Molde de UM card de categoria da tela de Início (mesmo visual dos cards originais,
     que antes estavam repetidos 5 vezes dentro de activity_busca_inicio.xml).
     O InicioActivity "infla" (cria) uma cópia deste molde para cada categoria do banco. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_caixa_borda"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/ivIconeCategoria"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/cat_higiene" />

    <TextView
        android:id="@+id/tvNomeCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        tools:text="Higiene" />
</LinearLayout>