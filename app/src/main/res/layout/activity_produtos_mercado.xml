<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/produtos_mercado"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <include layout="@layout/layout_cabecalho" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/campoBusca"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_caixa_borda"
                    android:drawableStart="@drawable/ic_busca"
                    android:drawablePadding="10dp"
                    android:hint="@string/hint_busca_produto"
                    android:importantForAutofill="no"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/preto"
                    android:textColorHint="#999999"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivLogoMercado"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/desc_logo_mercado"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/mercado_hipermais" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAtualizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/preco_atualizado"
                android:textColor="@color/cinza_texto"
                android:textSize="9sp"
                android:textStyle="italic" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_painel_cinza"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="48dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/produto_label"
                        android:textColor="@color/preto"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preco_label"
                        android:textColor="@color/preto"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listaProdutos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvListaVazia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/nenhum_produto"
                    android:textColor="@color/cinza_texto"
                    android:textStyle="italic"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCadastrarProduto"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/altura_botao"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="20dp"
                android:text="@string/cadastrar_produto"
                android:textColor="@color/branco"
                android:textSize="@dimen/texto_rotulo"
                android:textStyle="bold"
                app:backgroundTint="@color/verde_primario"
                app:cornerRadius="26dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_barra_inferior" />
</LinearLayout>
